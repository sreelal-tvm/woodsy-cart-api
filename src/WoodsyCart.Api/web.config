<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk settings for the WoodsyCart API (api.woodsycart.com).
  "dotnet publish" copies this file into the publish folder and fills in processPath / arguments.
  Secrets do NOT go here: put them in appsettings.Production.json on the server (docs/deployment/plesk-windows-guide.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV blocks PUT and DELETE (used by the admin app) on many IIS servers -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WoodsyCart.Api.dll" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- photo and bill uploads from the admin app: up to 25 MB -->
          <requestLimits maxAllowedContentLength="26214400" />
          <hiddenSegments>
            <add segment="App_Data" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
